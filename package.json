{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "landing": "python3 scripts/make_landing.py",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.mts",
