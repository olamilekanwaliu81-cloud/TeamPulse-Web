# Copy this file to .env.local and fill it in. Never commit .env.local.

# Supabase: Project settings > Database > Connection string > URI (use the "Transaction pooler" one on Vercel).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres

# A long random string that signs sign-in cookies. Make one with:  openssl rand -base64 48
SESSION_SECRET=

# The address of the site. Links in emails use it.
APP_URL=http://localhost:3000

# Email (Resend). Leave empty while testing: emails are then saved and shown at /dev/mailbox.
RESEND_API_KEY=
EMAIL_FROM=TeamPulse <hello@yourdomain.com>

# Set to 1 only if you want /dev/mailbox to work in production. Leave empty when real people use the app.
MAILBOX_ENABLED=
